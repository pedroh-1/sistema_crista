# Copie para .env. Os valores batem com o docker-compose.yml.
DATABASE_URL=postgresql://crista:crista@localhost:5432/crista
API_PORT=3000
# Gere um segredo próprio: openssl rand -base64 48
JWT_SECRET=troque-este-segredo
WEB_URL=http://localhost:4200
# Sem SMTP_HOST, os e-mails são escritos no log da API (Mailpit no docker-compose: localhost:1025).
SMTP_HOST=
SMTP_PORT=1025
EMAIL_REMETENTE=CRISTA <nao-responda@crista.local>
TERMOS_VERSAO=2026-10
# Pasta dos anexos no disco (em produção: S3)
ARMAZENAMENTO_DIR=./armazenamento
