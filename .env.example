# Copie para .env. Os valores servem para o ambiente local; produção: docs/07-producao.md.
# A API confere estas variáveis ao subir e não sobe se algo estiver errado.
NODE_ENV=development
DATABASE_URL=postgresql://crista:crista@localhost:5432/crista
API_PORT=3000
# Gere um segredo próprio: openssl rand -base64 48 (em produção, 32+ caracteres)
JWT_SECRET=troque-este-segredo
WEB_URL=http://localhost:4200
# Proxies confiáveis para o IP do cliente (limite de requisições). Padrão: loopback.
CONFIAR_PROXY=loopback

# E-mail. Sem SMTP_HOST, os e-mails são escritos no log da API (só fora de produção).
SMTP_HOST=
SMTP_PORT=587
# true na porta 465 (TLS direto); false na 587 (STARTTLS)
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=CRISTA <nao-responda@crista.local>
TERMOS_VERSAO=2026-10

# Anexos: disco (padrão) ou s3
ARMAZENAMENTO=disco
ARMAZENAMENTO_DIR=./armazenamento
S3_BUCKET=
S3_REGIAO=sa-east-1
# Só para S3 compatível (MinIO): http://localhost:9000
S3_ENDPOINT=
# Sem chave, vale a cadeia padrão da AWS (perfil, papel da instância)
S3_ACESSO=
S3_SEGREDO=

# Backup (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETER_DIAS=14
