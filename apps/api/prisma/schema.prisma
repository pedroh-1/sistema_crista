// Modelo de dados: docs/04-modelo-de-dados.md
// Um schema PostgreSQL por módulo, para manter as fronteiras do monólito modular.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["conta", "fazenda", "producao", "sanidade", "custos", "alertas", "equipamentos", "referencia", "arquivo", "fila", "auditoria"]
}

// ---------- conta ----------

enum StatusUsuario {
  pendente
  ativo

  @@schema("conta")
}

enum TipoToken {
  email
  senha

  @@schema("conta")
}

model Usuario {
  id                String        @id @default(uuid(7)) @db.Uuid
  nome              String
  email             String        @unique
  telefone          String?
  cpf               String?       @unique
  senhaHash         String        @map("senha_hash")
  status            StatusUsuario @default(pendente)
  emailVerificadoEm DateTime?     @map("email_verificado_em")
  criadoEm          DateTime      @default(now()) @map("criado_em")

  aceites  AceiteTermos[]
  tokens   TokenVerificacao[]
  vinculos Vinculo[]          @relation("vinculo_usuario")

  @@map("usuario")
  @@schema("conta")
}

model AceiteTermos {
  id           String   @id @default(uuid(7)) @db.Uuid
  usuarioId    String   @map("id_usuario") @db.Uuid
  versaoTermos String   @map("versao_termos")
  aceitoEm     DateTime @default(now()) @map("aceito_em")
  ip           String?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("aceite_termos")
  @@schema("conta")
}

model TokenVerificacao {
  id        String    @id @default(uuid(7)) @db.Uuid
  usuarioId String    @map("id_usuario") @db.Uuid
  tipo      TipoToken
  hashToken String    @unique @map("hash_token")
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("token_verificacao")
  @@schema("conta")
}

// ---------- fazenda ----------

enum TipoCriacao {
  corte

  @@schema("fazenda")
}

enum TipoGalpao {
  convencional
  climatizado
  dark_house

  @@schema("fazenda")
}

enum SituacaoGalpao {
  disponivel
  ocupado
  inativo

  @@schema("fazenda")
}

enum Perfil {
  gestor
  produtor
  veterinario
  operador
  consulta

  @@schema("fazenda")
}

enum StatusVinculo {
  pendente
  ativo
  expirado
  revogado

  @@schema("fazenda")
}

model Fazenda {
  id          String      @id @default(uuid(7)) @db.Uuid
  nome        String
  documento   String      @unique
  logradouro  String?
  municipio   String
  uf          String      @db.Char(2)
  latitude    Decimal?    @db.Decimal(9, 6)
  longitude   Decimal?    @db.Decimal(9, 6)
  integradora String?
  tipoCriacao TipoCriacao @default(corte) @map("tipo_criacao")
  criadoPorId String      @map("criado_por") @db.Uuid
  criadoEm    DateTime    @default(now()) @map("criado_em")

  galpoes  Galpao[]
  vinculos Vinculo[]
  lotes    Lote[]

  @@map("fazenda")
  @@schema("fazenda")
}

model Galpao {
  id             String         @id @default(uuid(7)) @db.Uuid
  fazendaId      String         @map("id_fazenda") @db.Uuid
  identificacao  String
  areaUtilM2     Decimal        @map("area_util_m2") @db.Decimal(10, 2)
  capacidadeAves Int            @map("capacidade_aves")
  tipo           TipoGalpao
  situacao       SituacaoGalpao @default(disponivel)
  criadoEm       DateTime       @default(now()) @map("criado_em")

  fazenda      Fazenda         @relation(fields: [fazendaId], references: [id])
  vinculos     VinculoGalpao[]
  lotes        Lote[]
  equipamentos Equipamento[]

  @@unique([fazendaId, identificacao])
  @@map("galpao")
  @@schema("fazenda")
}

// Convite e acesso de um usuário a uma fazenda (UC04). Enquanto o convite está
// pendente, o vínculo é identificado pelo e-mail convidado e usuarioId fica nulo.
model Vinculo {
  id              String        @id @default(uuid(7)) @db.Uuid
  fazendaId       String        @map("id_fazenda") @db.Uuid
  usuarioId       String?       @map("id_usuario") @db.Uuid
  emailConvidado  String        @map("email_convidado")
  perfil          Perfil
  crmv            String?
  validoAte       DateTime?     @map("valido_ate") @db.Date
  status          StatusVinculo @default(pendente)
  hashConvite     String?       @unique @map("hash_token_convite")
  conviteExpiraEm DateTime?     @map("convite_expira_em")
  convidadoPorId  String?       @map("convidado_por") @db.Uuid
  criadoEm        DateTime      @default(now()) @map("criado_em")
  aceitoEm        DateTime?     @map("aceito_em")
  revogadoEm      DateTime?     @map("revogado_em")

  fazenda Fazenda         @relation(fields: [fazendaId], references: [id])
  usuario Usuario?        @relation("vinculo_usuario", fields: [usuarioId], references: [id])
  galpoes VinculoGalpao[]

  @@index([fazendaId])
  @@index([usuarioId])
  @@map("vinculo_usuario_fazenda")
  @@schema("fazenda")
}

// Galpões permitidos ao vínculo. Sem linhas, o acesso vale para a fazenda inteira.
model VinculoGalpao {
  vinculoId String @map("id_vinculo") @db.Uuid
  galpaoId  String @map("id_galpao") @db.Uuid

  vinculo Vinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  galpao  Galpao  @relation(fields: [galpaoId], references: [id])

  @@id([vinculoId, galpaoId])
  @@map("vinculo_galpao")
  @@schema("fazenda")
}

// ---------- producao ----------
// Os registros do ciclo são eventos: só aceitam inserção, e a correção é um
// estorno (docs/05-sincronizacao.md). Campos derivados não são gravados.

enum Linhagem {
  cobb500
  ross308
  hubbard
  outra

  @@schema("producao")
}

enum Sexagem {
  misto
  macho
  femea

  @@schema("producao")
}

enum SituacaoLote {
  em_andamento
  encerrado
  cancelado

  @@schema("producao")
}

// pendente_revisao: chegou do app offline quebrando uma regra (Fase 3)
enum StatusEvento {
  valido
  pendente_revisao

  @@schema("producao")
}

enum TipoMovimentoRacao {
  entrada
  estoque_restante

  @@schema("producao")
}

model Lote {
  id                      String       @id @default(uuid(7)) @db.Uuid
  fazendaId               String       @map("id_fazenda") @db.Uuid
  galpaoId                String       @map("id_galpao") @db.Uuid
  codigo                  String
  linhagem                Linhagem
  sexagem                 Sexagem      @default(misto)
  origem                  String?
  dataAlojamento          DateTime     @map("data_alojamento") @db.Date
  idadeInicialDias        Int          @default(0) @map("idade_inicial_dias")
  pesoPintoG              Decimal?     @map("peso_pinto_g") @db.Decimal(6, 2)
  custoPinto              Decimal?     @map("custo_pinto") @db.Decimal(10, 4)
  quantidadePrevista      Int          @map("quantidade_prevista")
  precoReferenciaKg       Decimal?     @map("preco_referencia_kg") @db.Decimal(10, 4)
  situacao                SituacaoLote @default(em_andamento)
  confirmouDensidadePorId String?      @map("confirmou_densidade_por") @db.Uuid
  criadoPorId             String       @map("criado_por") @db.Uuid
  criadoEm                DateTime     @default(now()) @map("criado_em")

  fazenda      Fazenda               @relation(fields: [fazendaId], references: [id])
  galpao       Galpao                @relation(fields: [galpaoId], references: [id])
  alojamento   Alojamento?
  baixas       EventoBaixa[]
  pesagens     Pesagem[]
  movimentos   MovimentoRacao[]
  ocorrencias  OcorrenciaSanitaria[]
  rateios      DespesaRateio[]
  cargas       SaidaCarga[]
  encerramento EncerramentoLote?

  @@unique([fazendaId, codigo])
  @@index([galpaoId])
  @@map("lote")
  @@schema("producao")
}

// Um por lote. É cadastro (editável com auditoria), não evento.
model Alojamento {
  id                       String   @id @default(uuid(7)) @db.Uuid
  fazendaId                String   @map("id_fazenda") @db.Uuid
  loteId                   String   @unique @map("id_lote") @db.Uuid
  data                     DateTime @db.Date
  avesRecebidas            Int      @map("aves_recebidas")
  mortasTransporte         Int      @default(0) @map("mortas_transporte")
  justificativaDivergencia String?  @map("justificativa_divergencia")
  confirmouDensidadePorId  String?  @map("confirmou_densidade_por") @db.Uuid
  criadoPorId              String   @map("criado_por") @db.Uuid
  criadoEm                 DateTime @default(now()) @map("criado_em")

  lote Lote @relation(fields: [loteId], references: [id])

  @@map("alojamento")
  @@schema("producao")
}

model EventoBaixa {
  id            String       @id @default(uuid(7)) @db.Uuid
  fazendaId     String       @map("id_fazenda") @db.Uuid
  loteId        String       @map("id_lote") @db.Uuid
  data          DateTime     @db.Date
  mortes        Int
  descartes     Int          @default(0)
  causaProvavel String?      @map("causa_provavel")
  status        StatusEvento @default(valido)
  registradoEm  DateTime     @default(now()) @map("registrado_em")
  recebidoEm    DateTime     @default(now()) @map("recebido_em")
  criadoPorId   String       @map("criado_por") @db.Uuid

  lote Lote @relation(fields: [loteId], references: [id])

  @@index([loteId, data])
  @@map("evento_baixa")
  @@schema("producao")
}

model Pesagem {
  id                String       @id @default(uuid(7)) @db.Uuid
  fazendaId         String       @map("id_fazenda") @db.Uuid
  loteId            String       @map("id_lote") @db.Uuid
  data              DateTime     @db.Date
  avesPesadas       Int          @map("aves_pesadas")
  pesoTotalG        Decimal      @map("peso_total_g") @db.Decimal(12, 2)
  pontoColeta       String?      @map("ponto_coleta")
  revisaoConfirmada Boolean      @default(false) @map("revisao_confirmada")
  status            StatusEvento @default(valido)
  registradoEm      DateTime     @default(now()) @map("registrado_em")
  recebidoEm        DateTime     @default(now()) @map("recebido_em")
  criadoPorId       String       @map("criado_por") @db.Uuid

  lote  Lote                @relation(fields: [loteId], references: [id])
  pesos PesagemIndividual[]

  @@index([loteId, data])
  @@map("pesagem")
  @@schema("producao")
}

model PesagemIndividual {
  id        String  @id @default(uuid(7)) @db.Uuid
  pesagemId String  @map("id_pesagem") @db.Uuid
  pesoG     Decimal @map("peso_g") @db.Decimal(8, 2)

  pesagem Pesagem @relation(fields: [pesagemId], references: [id])

  @@index([pesagemId])
  @@map("pesagem_individual")
  @@schema("producao")
}

model MovimentoRacao {
  id           String             @id @default(uuid(7)) @db.Uuid
  fazendaId    String             @map("id_fazenda") @db.Uuid
  loteId       String             @map("id_lote") @db.Uuid
  data         DateTime           @db.Date
  tipo         TipoMovimentoRacao
  quantidadeKg Decimal            @map("quantidade_kg") @db.Decimal(12, 3)
  fornecedor   String?
  notaFiscal   String?            @map("nota_fiscal")
  // Entrega com valor gera a despesa de ração junto (UC12)
  despesaId    String?            @map("id_despesa") @db.Uuid
  status       StatusEvento       @default(valido)
  registradoEm DateTime           @default(now()) @map("registrado_em")
  recebidoEm   DateTime           @default(now()) @map("recebido_em")
  criadoPorId  String             @map("criado_por") @db.Uuid

  lote Lote @relation(fields: [loteId], references: [id])

  @@index([loteId, data])
  @@map("movimento_racao")
  @@schema("producao")
}

// Cancela um evento (baixa, pesagem, ração ou ocorrência) sem apagá-lo.
model Estorno {
  id          String   @id @default(uuid(7)) @db.Uuid
  fazendaId   String   @map("id_fazenda") @db.Uuid
  entidade    String
  idEvento    String   @unique @map("id_evento") @db.Uuid
  motivo      String
  criadoPorId String   @map("criado_por") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@map("estorno")
  @@schema("producao")
}

// Carga de saída das aves (UC17). Um lote pode sair em várias cargas. Evento.
model SaidaCarga {
  id           String       @id @default(uuid(7)) @db.Uuid
  fazendaId    String       @map("id_fazenda") @db.Uuid
  loteId       String       @map("id_lote") @db.Uuid
  data         DateTime     @db.Date
  aves         Int
  pesoTotalKg  Decimal      @map("peso_total_kg") @db.Decimal(12, 3)
  precoKg      Decimal?     @map("preco_kg") @db.Decimal(10, 4)
  destino      String?
  numeroGta    String?      @map("numero_gta")
  status       StatusEvento @default(valido)
  registradoEm DateTime     @default(now()) @map("registrado_em")
  recebidoEm   DateTime     @default(now()) @map("recebido_em")
  criadoPorId  String       @map("criado_por") @db.Uuid

  lote Lote @relation(fields: [loteId], references: [id])

  @@index([loteId, data])
  @@map("saida_carga")
  @@schema("producao")
}

// Resultado congelado no encerramento (UC17). Não muda depois de gravado.
model EncerramentoLote {
  id               String   @id @default(uuid(7)) @db.Uuid
  fazendaId        String   @map("id_fazenda") @db.Uuid
  loteId           String   @unique @map("id_lote") @db.Uuid
  dataEncerramento DateTime @map("data_encerramento") @db.Date
  parcial          Boolean
  pendencias       Json
  resultado        Json
  encerradoPorId   String   @map("encerrado_por") @db.Uuid
  encerradoEm      DateTime @default(now()) @map("encerrado_em")

  lote Lote @relation(fields: [loteId], references: [id])

  @@map("encerramento_lote")
  @@schema("producao")
}

// ---------- sanidade ----------

enum TipoOcorrencia {
  doenca
  vacinacao
  medicacao
  anomalia
  inspecao

  @@schema("sanidade")
}

enum ViaAplicacao {
  agua
  racao
  spray
  ocular
  injetavel
  outra

  @@schema("sanidade")
}

model OcorrenciaSanitaria {
  id           String         @id @default(uuid(7)) @db.Uuid
  fazendaId    String         @map("id_fazenda") @db.Uuid
  loteId       String         @map("id_lote") @db.Uuid
  data         DateTime       @db.Date
  tipo         TipoOcorrencia
  descricao    String
  produto      String?
  dose         String?
  via          ViaAplicacao?
  loteProduto  String?        @map("lote_produto")
  carenciaDias Int?           @map("carencia_dias")
  status       StatusEvento   @default(valido)
  registradoEm DateTime       @default(now()) @map("registrado_em")
  recebidoEm   DateTime       @default(now()) @map("recebido_em")
  criadoPorId  String         @map("criado_por") @db.Uuid

  lote Lote @relation(fields: [loteId], references: [id])

  @@index([loteId, data])
  @@map("ocorrencia_sanitaria")
  @@schema("sanidade")
}

// ---------- custos ----------

enum CategoriaDespesa {
  racao
  medicamentos
  energia
  gas
  mao_de_obra
  cama
  manutencao
  transporte
  outros

  @@schema("custos")
}

enum CriterioRateio {
  aves_alojadas
  consumo_racao
  percentual

  @@schema("custos")
}

enum OrigemDespesa {
  manual
  racao
  manutencao

  @@schema("custos")
}

// Evento: só aceita inserção; a correção é um estorno.
model Despesa {
  id                    String           @id @default(uuid(7)) @db.Uuid
  fazendaId             String           @map("id_fazenda") @db.Uuid
  data                  DateTime         @db.Date
  categoria             CategoriaDespesa
  descricao             String
  valor                 Decimal          @db.Decimal(14, 2)
  fornecedor            String?
  numeroNota            String?          @map("numero_nota")
  criterioRateio        CriterioRateio?  @map("criterio_rateio")
  origem                OrigemDespesa    @default(manual)
  // Despesa gerada pelo custo de uma manutenção (UC19)
  manutencaoId          String?          @map("id_manutencao") @db.Uuid
  duplicidadeConfirmada Boolean          @default(false) @map("duplicidade_confirmada")
  status                StatusEvento     @default(valido)
  registradoEm          DateTime         @default(now()) @map("registrado_em")
  recebidoEm            DateTime         @default(now()) @map("recebido_em")
  criadoPorId           String           @map("criado_por") @db.Uuid

  rateios DespesaRateio[]

  @@index([fazendaId, data])
  @@index([fazendaId, numeroNota])
  @@index([manutencaoId])
  @@map("despesa")
  @@schema("custos")
}

// Parcela da despesa em cada lote. Sem parcelas, a despesa é da fazenda.
model DespesaRateio {
  id         String  @id @default(uuid(7)) @db.Uuid
  despesaId  String  @map("id_despesa") @db.Uuid
  loteId     String  @map("id_lote") @db.Uuid
  percentual Decimal @db.Decimal(7, 4)
  valor      Decimal @db.Decimal(14, 2)

  despesa Despesa @relation(fields: [despesaId], references: [id])
  lote    Lote    @relation(fields: [loteId], references: [id])

  @@index([loteId])
  @@index([despesaId])
  @@map("despesa_rateio")
  @@schema("custos")
}

// ---------- alertas (UC16) ----------

enum IndicadorAlerta {
  mortalidade_dia
  desvio_peso
  uniformidade
  temperatura
  umidade
  amonia
  energia
  equipamento_parado
  falta_sinal

  @@schema("alertas")
}

enum Criticidade {
  atencao
  critico

  @@schema("alertas")
}

enum StatusAlerta {
  aberto
  fechado

  @@schema("alertas")
}

enum CanalNotificacao {
  email
  push
  sms

  @@schema("alertas")
}

enum StatusEnvio {
  pendente
  enviada
  falhou

  @@schema("alertas")
}

// Limites configurados pela fazenda. Sem regra, valem os limites padrão (sinalizados).
model RegraAlerta {
  id              String          @id @default(uuid(7)) @db.Uuid
  fazendaId       String          @map("id_fazenda") @db.Uuid
  indicador       IndicadorAlerta
  limiteAtencao   Decimal         @map("limite_atencao") @db.Decimal(10, 4)
  limiteCritico   Decimal         @map("limite_critico") @db.Decimal(10, 4)
  atualizadoPorId String          @map("atualizado_por") @db.Uuid
  atualizadoEm    DateTime        @default(now()) @updatedAt @map("atualizado_em")

  @@unique([fazendaId, indicador])
  @@map("regra_alerta")
  @@schema("alertas")
}

// Um alerta aberto por lote e indicador; um novo desvio atualiza o aberto.
model Alerta {
  id             String          @id @default(uuid(7)) @db.Uuid
  fazendaId      String          @map("id_fazenda") @db.Uuid
  loteId         String?         @map("id_lote") @db.Uuid
  galpaoId       String?         @map("id_galpao") @db.Uuid
  // Alerta de equipamento parado (UC19): um aberto por equipamento
  equipamentoId  String?         @map("id_equipamento") @db.Uuid
  indicador      IndicadorAlerta
  criticidade    Criticidade
  valor          Decimal         @db.Decimal(12, 4)
  limite         Decimal         @db.Decimal(12, 4)
  limitePadrao   Boolean         @map("limite_padrao")
  dataReferencia DateTime        @map("data_referencia") @db.Date
  mensagem       String
  status         StatusAlerta    @default(aberto)
  abertoEm       DateTime        @default(now()) @map("aberto_em")
  atualizadoEm   DateTime        @default(now()) @updatedAt @map("atualizado_em")
  fechadoEm      DateTime?       @map("fechado_em")
  fechadoPorId   String?         @map("fechado_por") @db.Uuid
  providencia    String?

  notificacoes Notificacao[]

  @@index([fazendaId, status])
  @@map("alerta")
  @@schema("alertas")
}

model Notificacao {
  id         String           @id @default(uuid(7)) @db.Uuid
  alertaId   String           @map("id_alerta") @db.Uuid
  usuarioId  String           @map("id_usuario") @db.Uuid
  canal      CanalNotificacao
  status     StatusEnvio      @default(pendente)
  tentativas Int              @default(0)
  enviadoEm  DateTime?        @map("enviado_em")
  erro       String?
  criadoEm   DateTime         @default(now()) @map("criado_em")

  alerta Alerta @relation(fields: [alertaId], references: [id])

  @@index([alertaId])
  @@map("notificacao")
  @@schema("alertas")
}

// ---------- equipamentos (UC18 e UC19) ----------

enum TipoEquipamento {
  comedouro
  bebedouro
  ventilacao
  aquecimento
  nebulizacao
  iluminacao
  gerador
  outro

  @@schema("equipamentos")
}

enum SituacaoEquipamento {
  ativo
  inativo

  @@schema("equipamentos")
}

enum TipoManutencao {
  preventiva
  corretiva

  @@schema("equipamentos")
}

// Cadastro: editável pela web, com auditoria. Sem galpão, é da fazenda inteira
// (inconsistência #4).
model Equipamento {
  id                String              @id @default(uuid(7)) @db.Uuid
  fazendaId         String              @map("id_fazenda") @db.Uuid
  galpaoId          String?             @map("id_galpao") @db.Uuid
  nome              String
  tipo              TipoEquipamento
  numeroSerie       String?             @map("numero_serie")
  fabricante        String?
  modelo            String?
  critico           Boolean             @default(false)
  periodicidadeDias Int?                @map("periodicidade_dias")
  dataAquisicao     DateTime?           @map("data_aquisicao") @db.Date
  situacao          SituacaoEquipamento @default(ativo)
  criadoEm          DateTime            @default(now()) @map("criado_em")

  galpao      Galpao?      @relation(fields: [galpaoId], references: [id])
  manutencoes Manutencao[]

  // Nulos não colidem: a série só é única quando informada.
  @@unique([fazendaId, numeroSerie])
  @@index([fazendaId])
  @@map("equipamento")
  @@schema("equipamentos")
}

// Evento: só aceita inserção, exceto o registro do retorno de uma parada aberta.
// A correção é um estorno, que leva junto a despesa gerada.
model Manutencao {
  id              String         @id @default(uuid(7)) @db.Uuid
  fazendaId       String         @map("id_fazenda") @db.Uuid
  equipamentoId   String         @map("id_equipamento") @db.Uuid
  tipo            TipoManutencao
  data            DateTime       @db.Date
  descricao       String
  custoPecas      Decimal        @default(0) @map("custo_pecas") @db.Decimal(14, 2)
  custoMaoObra    Decimal        @default(0) @map("custo_mao_obra") @db.Decimal(14, 2)
  fornecedor      String?
  ordemServico    String?        @map("ordem_servico")
  paradaInicio    DateTime?      @map("parada_inicio")
  retornoOperacao DateTime?      @map("retorno_operacao")
  retornoPorId    String?        @map("retorno_por") @db.Uuid
  registradoEm    DateTime       @default(now()) @map("registrado_em")
  criadoPorId     String         @map("criado_por") @db.Uuid

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id])

  @@index([equipamentoId, data])
  @@map("manutencao_equipamento")
  @@schema("equipamentos")
}

// ---------- fila ----------

enum StatusTarefa {
  pendente
  processando
  concluida
  falhou

  @@schema("fila")
}

// Fila de tarefas no próprio PostgreSQL (outbox): gravada na mesma transação do
// lançamento e executada depois, para um pico de alertas não travar o registro (RNF07).
model Tarefa {
  id           String       @id @default(uuid(7)) @db.Uuid
  tipo         String
  payload      Json
  status       StatusTarefa @default(pendente)
  tentativas   Int          @default(0)
  disponivelEm DateTime     @default(now()) @map("disponivel_em")
  erro         String?
  criadoEm     DateTime     @default(now()) @map("criado_em")
  concluidaEm  DateTime?    @map("concluida_em")

  @@index([status, disponivelEm])
  @@map("tarefa")
  @@schema("fila")
}

// ---------- referencia ----------

// Curva de desempenho por linhagem (doc 06). fonte = 'sintetico' é curva de teste.
model CurvaReferencia {
  id                String   @id @default(uuid(7)) @db.Uuid
  linhagem          Linhagem
  sexo              Sexagem
  idadeDias         Int      @map("idade_dias")
  pesoG             Decimal  @map("peso_g") @db.Decimal(8, 2)
  consumoAcumG      Decimal? @map("consumo_acum_g") @db.Decimal(10, 2)
  mortalidadeDiaPct Decimal? @map("mortalidade_dia_pct") @db.Decimal(6, 4)
  fonte             String
  versao            String

  @@unique([linhagem, sexo, idadeDias, versao])
  @@map("curva_referencia")
  @@schema("referencia")
}

// ---------- arquivo ----------

// Anexo de qualquer registro (RNF08: jpg, png ou pdf, até 10 MB).
model Anexo {
  id          String   @id @default(uuid(7)) @db.Uuid
  fazendaId   String   @map("id_fazenda") @db.Uuid
  entidade    String
  idEntidade  String   @map("id_entidade") @db.Uuid
  chave       String   @unique
  nome        String
  mime        String
  tamanho     Int
  sha256      String
  criadoPorId String   @map("criado_por") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([entidade, idEntidade])
  @@map("anexo")
  @@schema("arquivo")
}

// ---------- auditoria ----------

enum OrigemEvento {
  web
  app
  sistema

  @@schema("auditoria")
}

// Só aceita inserção (docs/05-sincronizacao.md).
model EventoAuditoria {
  id           String       @id @default(uuid(7)) @db.Uuid
  fazendaId    String?      @map("id_fazenda") @db.Uuid
  usuarioId    String?      @map("id_usuario") @db.Uuid
  acao         String
  entidade     String
  idEntidade   String       @map("id_entidade") @db.Uuid
  antes        Json?
  depois       Json?
  origem       OrigemEvento @default(web)
  registradoEm DateTime     @default(now()) @map("registrado_em")
  recebidoEm   DateTime     @default(now()) @map("recebido_em")

  @@index([fazendaId, registradoEm])
  @@index([entidade, idEntidade])
  @@map("evento_auditoria")
  @@schema("auditoria")
}
